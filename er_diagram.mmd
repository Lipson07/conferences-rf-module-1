erDiagram
    users ||--o{ bookings : creates
    rooms ||--o{ bookings : reserves
    bookings ||--o| reviews : receives
    users {
        SERIAL id PK
        VARCHAR login UK
        VARCHAR password_hash
        VARCHAR full_name
        VARCHAR phone
        VARCHAR email
        VARCHAR role
    }
    rooms {
        SERIAL id PK
        VARCHAR name UK
        VARCHAR room_type
    }
    bookings {
        SERIAL id PK
        INTEGER user_id FK
        INTEGER room_id FK
        DATE start_date
        INTEGER participants
        VARCHAR payment_method
        VARCHAR status
        TIMESTAMP created_at
    }
    reviews {
        SERIAL id PK
        INTEGER booking_id FK,UK
        TEXT text
        TIMESTAMP created_at
    }
